CLOUD_DATABASE_URL=postgresql://smartschool:smartschool@localhost:5433/smartschool_cloud
# 32 random bytes, base64 — encrypts installation secrets at rest
CLOUD_ENCRYPTION_KEY=
# Ed25519 keys (run `pnpm keys:generate`). The PUBLIC key is distributed to schools as CLOUD_PUBLIC_KEY.
CLOUD_SIGNING_PRIVATE_KEY=
CLOUD_SIGNING_PUBLIC_KEY=
# Where uploaded school backups are stored
BACKUP_STORAGE_DIR=./.data/backups
SESSION_TTL_HOURS=8
NODE_ENV=development
