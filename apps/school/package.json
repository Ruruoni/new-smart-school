    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
