// ───────────────────────── PEOPLE ─────────────────────────
// Students, guardians, teachers, staff. Offline-created → UUID keys. Business "numbers"
// (admission number, staff number) are separate unique columns generated by a per-school sequence rule.

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  TRANSFERRED
  GRADUATED
}

model StudentProfile {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String?       @unique @db.Uuid // optional login (needed for CBT)
  admissionNumber   String        @unique
  firstName         String
  middleName        String?
  lastName          String
  gender            Gender
  dateOfBirth       DateTime?     @db.Date
  stateOfOrigin     String?
  lga               String?
  nationality       String        @default("Nigerian")
  religion          String?
  bloodGroup        String?
  genotype          String?
  address           String?
  phone             String?
  photoFileId       String?       @db.Uuid
  status            StudentStatus @default(ACTIVE)
  admittedOn        DateTime?     @db.Date
  admissionRecordId String?       @unique @db.Uuid
  medicalNotes      String?
  deletedAt         DateTime?
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionRecord  AdmissionRecord?       @relation(fields: [admissionRecordId], references: [id], onDelete: SetNull)
  guardians        GuardianRelationship[]
  enrollments      Enrollment[]
  documents        StudentDocument[]
  statusHistory    StudentStatusHistory[]
  assessmentScores AssessmentScore[]
  examResults      ExamResult[]
  reportCards      ReportCard[]
  promotions       PromotionRecord[]
  studentFees      StudentFee[]
  discounts        StudentDiscount[]
  invoices         Invoice[]
  payments         Payment[]
  attendance       AttendanceLog[]
  cbtAttempts      CBTAttempt[]
  topicPerformance CBTTopicPerformance[]

  @@index([lastName, firstName])
  @@index([status])
  @@map("students")
}

model StudentStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  studentId   String         @db.Uuid
  fromStatus  StudentStatus?
  toStatus    StudentStatus
  reason      String?
  changedById String?        @db.Uuid
  changedAt   DateTime       @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, changedAt])
  @@map("student_status_history")
}

model StudentDocument {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @db.Uuid
  kind       String // "BIRTH_CERTIFICATE", "PREVIOUS_RESULT", "TRANSFER_LETTER"
  fileId     String   @db.Uuid
  uploadedAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

model ParentProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  firstName  String
  lastName   String
  occupation String?
  address    String?
  phone      String?
  email      String?
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  children GuardianRelationship[]

  @@map("parents")
}

model GuardianRelationship {
  id             String   @id @default(uuid()) @db.Uuid
  studentId      String   @db.Uuid
  parentId       String   @db.Uuid
  relationship   String // "Father", "Mother", "Guardian", "Uncle"…
  isPrimary      Boolean  @default(false)
  /// Whether this guardian may view fees / results. Defaults true; the school can restrict.
  canViewFinance Boolean  @default(true)
  canViewResults Boolean  @default(true)
  createdAt      DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
  @@map("guardian_relationships")
}

model TeacherProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  staffNumber    String    @unique
  qualification  String?
  specialization String?
  employedOn     DateTime? @db.Date
  phone          String?
  address        String?
  deletedAt      DateTime?
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections      Section[]
  classSubjects ClassSubject[]
  slots         TimetableSlot[]
  lessonNotes   LessonNote[]

  @@map("teachers")
}

model StaffProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  staffNumber String    @unique
  department  String?
  position    String?
  employedOn  DateTime? @db.Date
  phone       String?
  address     String?
  deletedAt   DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  TRANSFERRED
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @db.Uuid
  classId        String           @db.Uuid
  sectionId      String?          @db.Uuid
  academicYearId String           @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  enrolledOn     DateTime         @default(now()) @db.Date
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student        StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class          SchoolClass       @relation(fields: [classId], references: [id], onDelete: Restrict)
  section        Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  promotionsFrom PromotionRecord[]

  /// One enrollment per student per academic year.
  @@unique([studentId, academicYearId])
  @@index([classId, sectionId, academicYearId, status])
  @@index([sectionId])
  @@index([academicYearId])
  @@map("enrollments")
}
